{
  "name": "panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:size": "node scripts/check-file-size.mjs",
    "smoke": "node scripts/smoke-routes.mjs",
    "collect:now": "tsx --conditions=react-server --env-file=.env.local scripts/collect-now.mts",
    "import:local": "tsx --conditions=react-server --env-file=.env.local scripts/import-local-videos.mts",
    "analyze:now": "tsx --conditions=react-server --env-file=.env.local scripts/analyze-now.mts",
    "plan:week": "tsx --conditions=react-server --env-file=.env.local scripts/plan-week.mts",
    "viral:hunt": "tsx --conditions=react-server --env-file=.env.local scripts/viral-hunt.mts",
    "measure:now": "tsx --conditions=react-server --env-file=.env.local scripts/measure-now.mts",
    "measure:zernio": "tsx --conditions=react-server --env-file=.env.local scripts/measure-zernio.mts",
    "halka": "tsx --conditions=react-server --env-file=.env.local scripts/cycle.mts",
    "ajan": "tsx --conditions=react-server --env-file=.env.local scripts/director.mts",
    "siparis:yaz": "tsx --conditions=react-server --env-file=.env.local scripts/siparis-yaz.mts",
    "measure:check": "tsx --conditions=react-server --env-file=.env.local scripts/measure-check.mts",
    "label:angles": "tsx --conditions=react-server --env-file=.env.local scripts/label-angles.mts",
    "brief:now": "tsx --conditions=react-server --env-file=.env.local scripts/brief-now.mts",
    "proven:ideas": "tsx --conditions=react-server --env-file=.env.local scripts/proven-ideas.mts",
    "rutin": "tsx --conditions=react-server --env-file=.env.local scripts/routine.mts",
    "worker": "tsx --conditions=react-server --env-file=.env.local scripts/job-worker.mts",
    "workspace": "tsx --conditions=react-server --env-file=.env.local scripts/workspace.mts",
    "credits": "tsx --conditions=react-server --env-file=.env.local scripts/credits.mts",
    "kurulum": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/kurulum.mts",
    "gunluk": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/gunluk.mts",
    "db:start": "npx -y supabase@2.118.0 start",
    "db:stop": "npx -y supabase@2.118.0 stop",
    "db:reset": "npx -y supabase@2.118.0 db reset",
    "db:status": "npx -y supabase@2.118.0 status",
    "db:types": "node scripts/db-types.mjs",
    "db:test": "node scripts/db-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
