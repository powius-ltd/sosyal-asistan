# Müşteri kopyası ortam şablonu. Bu dosyayı .env.local olarak kopyala ve değerleri doldur. Gerçek anahtarı ASLA depoya koyma.
PANEL_EDITION=kopya
DATA_SOURCE=supabase
OPERATOR_MODE=local

# Supabase (kendi bulut projen): Project Settings > API'den.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Yedek için (Project Settings > Database > Connection string, URI): npm run gunluk haftada bir pg_dump alır.
SUPABASE_DB_URL=

# `npm run kurulum -- hesap` bu ikisini kendisi yazar; elle doldurma.
LOCAL_USER_ID=
LOCAL_WORKSPACE_ID=

# Apify (rakip ve kendi hesap verisi; ücretsiz katman ayda 5 USD): apify.com > Settings > API.
APIFY_TOKEN=
# Zernio (isteğe bağlı, yalnız ölçüm / okuma): çalışma alanı kısa adına göre ZERNIO_API_KEY_<KISA_AD> (büyük harf).
ZERNIO_API_KEY=

# Video incelemesi: Google hesabı gerekmez, Claude kareleri okur.
VIDEO_ANALYSIS_BACKEND=claude_frames
# Konuşma metni (yerel Whisper): venv içindeki python'un tam yolu (KURULUM.md).
WHISPER_PYTHON=
WHISPER_MODEL=medium

# Günlük tur: ajan ve zincir açık.
CYCLE_AUTO=on
AGENT_AUTO=on

# Fiş (sipariş) klasörü; boşsa repo içi siparisler/.
SIPARIS_KOK=
